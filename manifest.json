{
    "manifest_version": 3,
    "name": "smar",
    "version": "1.6",
    "description": "smar - a smart way to manage links",
    "short_name": "smar",
    "author": "hardik88t",
    "homepage_url": "https://hardik88t.github.io/smar/",
    "icons": {
        "16": "asset/img/s_.png",
        "32": "asset/img/s_.png",
        "64": "asset/img/s_.png",
        "128": "asset/img/s_.png"
    },
    "action": {
        "default_popup": "index.html",
        "default_icon": "asset/img/s_.png"
    },
    "permissions": [
        "storage",
        "activeTab"
    ],
    "offline_enabled": true
}