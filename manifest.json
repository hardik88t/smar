{
    "manifest_version": 3,
    "name": "smar",
    "version": "2.0",
    "description": "smar - the smarter way to manage your links and tabs",
    "short_name": "smar",
    "author": "hardik88t",
    "homepage_url": "https://hardik88t.github.io/smar/",
    "icons": {
        "16": "asset/img/s_.png",
        "32": "asset/img/s_.png",
        "64": "asset/img/s_.png",
        "128": "asset/img/s_.png"
    },
    "action": {
        "default_popup": "index.html",
        "default_icon": "asset/img/s_.png"
    },
    "background": {
        "service_worker": "background.js"
    },
    "permissions": [
        "storage",
        "activeTab",
        "contextMenus"
    ],
    "offline_enabled": true
}